{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/bot(.*)",
      "destination": "/api/bot?path=$1"
    },
    {
      "source": "/api/telegram(.*)",
      "destination": "/api/telegram?path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}